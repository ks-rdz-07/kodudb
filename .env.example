# KoduDB settings. Every secret below is optional: `node scripts/gen-env.mjs` fills in missing ones, and
# the API generates any that are still missing on first start (kept in its database, and appended to .env
# when there is one). Set a value yourself to choose it. Keep comments on their own lines.

# ---- API ----
# A Postgres user that may create databases and roles.
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/kodudb
# Signs every key and token; 32+ characters.
JWT_SECRET=
# Encrypts stored passwords and client secrets. Never change it once set.
ENCRYPTION_KEY=
# Console sign-in.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# The API's public address, used in email and sign-in links.
KODUDB_PUBLIC_URL=http://localhost:8787
# Where uploaded files go (default ./storage; /data/storage in the Docker image).
STORAGE_ROOT=
# PORT=8787
# Only behind your own reverse proxy (then X-Forwarded-For is trusted):
# TRUST_PROXY=1
# Where the API writes generated values (default ./.env when that file exists):
# KODUDB_ENV_FILE=/path/to/.env

# ---- Docker Compose ----
# Password of the bundled Postgres container.
POSTGRES_PASSWORD=

# ---- Console ----
# The console keeps no secrets; it only needs to reach the API.
KODUDB_API_URL=http://127.0.0.1:8787

# ---- PM2 / Windows ----
# API_PORT=8787
# CONSOLE_PORT=3100

# ---- Default project keys for your apps (written by gen-env.mjs; the console shows them too) ----
PUBLIC_KEY=
SECRET_KEY=
