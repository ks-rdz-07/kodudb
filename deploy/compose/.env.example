# deploy/compose settings. ./init-env.sh fills in the secrets for you.

# Required
POSTGRES_PASSWORD=
# Root credentials of the bundled RustFS storage; KoduDB creates one limited key per project from them.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Images (defaults shown)
# KODUDB_IMAGE_REGISTRY=docker.io/kns777
# KODUDB_VERSION=0.2.0
# RUSTFS_VERSION=1.0.4

# Public addresses (defaults are localhost; set these when the host is reachable by name)
# KODUDB_PUBLIC_URL=http://localhost:8787
# S3_PUBLIC_URL=http://localhost:9000
# S3_CONSOLE_URL=http://localhost:9001/rustfs/console/

# HTTPS through Caddy (docker compose --profile tls up -d): app./api./s3./storage.<DOMAIN> must resolve here.
# DOMAIN=example.com
# BIND_ADDRESS=127.0.0.1
# TRUST_PROXY=1

# Optional: choose these yourself instead of letting the API generate them on first start.
# JWT_SECRET=
# ENCRYPTION_KEY=
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=
